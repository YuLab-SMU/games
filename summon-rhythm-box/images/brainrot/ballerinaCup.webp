<style id="cpg-gallery-inline-css">

.cpg-gallery{display:flex;flex-direction:column;gap:24px;margin:32px 0}
.cpg-row{display:grid;gap:24px}
.cpg-cols-1 .cpg-row{grid-template-columns:1fr}
.cpg-cols-2 .cpg-row{grid-template-columns:repeat(2,minmax(0,1fr))}
.cpg-cols-3 .cpg-row{grid-template-columns:repeat(3,minmax(0,1fr))}
.cpg-cols-4 .cpg-row{grid-template-columns:repeat(4,minmax(0,1fr))}
.cpg-cols-5 .cpg-row{grid-template-columns:repeat(5,minmax(0,1fr))}
.cpg-cols-6 .cpg-row{grid-template-columns:repeat(6,minmax(0,1fr))}
.cpg-item{display:flex;flex-direction:column;align-items:center;text-align:center;background:#ffffff;border-radius:12px;padding:24px;box-shadow:0 1px 3px rgba(0,0,0,.06);height:100%;box-sizing:border-box}
.cpg-image{display:block;width:100%;margin-bottom:16px;line-height:0}
a.cpg-image{cursor:pointer;transition:transform .15s ease,opacity .15s ease}
a.cpg-image:hover{transform:translateY(-2px);opacity:.95}
.cpg-image .cpg-img{max-width:100%;height:auto;display:block;border:1px solid #eee;border-radius:8px;margin:0 auto}
.cpg-caption{margin:8px 0 8px;font-size:1.4rem;font-weight:700;line-height:1.3}
.cpg-description{display:block;margin:0 0 18px;color:#555;line-height:1.5}
.cpg-button{display:inline-block;margin-top:auto;padding:12px 32px;background:#cb3470;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:1rem;line-height:1;transition:opacity .15s ease,transform .15s ease}
.cpg-button:hover,.cpg-button:focus{opacity:.92;color:#ffffff;text-decoration:none;transform:translateY(-1px)}
.cpg-pagination{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin:32px 0 8px}
.cpg-pagination .cpg-page{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;padding:0 10px;border:1px solid #e5e7eb;border-radius:6px;color:#374151;text-decoration:none;font-weight:500;font-size:.95rem;transition:background .15s,border-color .15s}
.cpg-pagination a.cpg-page:hover{background:#f3f4f6;border-color:#d1d5db;color:#111}
.cpg-pagination .cpg-current{background:#cb3470;border-color:#cb3470;color:#ffffff}
.cpg-pagination .cpg-gap{display:inline-flex;align-items:center;padding:0 4px;color:#9ca3af}
.cpg-breadcrumbs{margin:0 0 12px;font-size:.9rem;color:#666;line-height:1.5}
.cpg-breadcrumbs-list{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:0}
.cpg-breadcrumb-item{display:inline-flex;align-items:center}
.cpg-breadcrumbs a{color:#666;text-decoration:none;border-bottom:1px solid transparent;transition:border-color .15s}
.cpg-breadcrumbs a:hover{border-bottom-color:#666}
.cpg-breadcrumbs [aria-current="page"]{color:#111;font-weight:500}
.cpg-breadcrumb-sep{color:#bbb;margin:0 6px}
.cpg-meta{margin:0 0 24px;padding:0 0 12px;font-size:.9rem;color:#666;border-bottom:1px solid #eee;line-height:1.5}
.cpg-meta a{color:#666;text-decoration:none;border-bottom:1px solid #ddd;transition:border-color .15s}
.cpg-meta a:hover{border-bottom-color:#666}
.cpg-meta-sep{margin:0 4px;color:#bbb}
@media (max-width:768px){
  .cpg-cols-2 .cpg-row,.cpg-cols-3 .cpg-row,.cpg-cols-4 .cpg-row,.cpg-cols-5 .cpg-row,.cpg-cols-6 .cpg-row{grid-template-columns:1fr}
}

/*# sourceURL=cpg-gallery-inline-css */
</style>
<link rel='stylesheet' id='novashare-css-css' href='https://brainrotcharacters.net/wp-content/plugins/novashare/css/style.min.css?ver=1.6.6' media='all' />
<style id="novashare-css-inline-css">
body .ns-pinterest-image{display:block;position:relative;margin:0;padding:0;line-height:0}figure>.ns-pinterest-image{height:100%;width:100%}body .wp-block-image .ns-pinterest-image+figcaption{display:block}body .ns-pinterest-image-button{transition:.3s;position:absolute;height:18px;max-height:18px;width:auto!important;padding:10px;cursor:pointer;background:#c92228;color:#fff;font-size:16px;line-height:18px;z-index:1;text-decoration:none;box-sizing:content-box;top:10px;left:10px}body .ns-pinterest-image-button:hover{box-shadow:inset 0 0 0 50px rgba(0,0,0,0.1);}body .ns-pinterest-image-button:visited, body .ns-pinterest-image-button:hover{color:#fff}body .ns-pinterest-image:hover .ns-pinterest-image-button{opacity:1}body .ns-pinterest-image-button svg{width:18px;height:18px;vertical-align:middle;pointer-events:none}.aligncenter .ns-pinterest-image{text-align:center}
/*# sourceURL=novashare-css-inline-css */
</style>
