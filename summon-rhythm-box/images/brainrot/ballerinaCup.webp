</style>
<script id="jquery-core-js" src="https://brainrotcharacters.net/wp-includes/js/jquery/jquery.min.js?ver=3.7.1"></script>
<script id="jquery-migrate-js" src="https://brainrotcharacters.net/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1"></script>
<link rel="https://api.w.org/" href="https://brainrotcharacters.net/wp-json/" /><meta name="generator" content="WordPress 7.0.3" />
<!-- Google One Tap — Email Collection -->
<script>
(function() {
    // Only suppress the prompt if the user has successfully signed in.
    // If they dismiss (click X / tap outside), we let it show again on
    // the next page view — we intentionally do NOT set a dismissal cookie.
    if (document.cookie.indexOf('bcc_onetap_done=') !== -1) return;

    // Inject GSI client library only if we actually need the prompt
    var gsi = document.createElement('script');
    gsi.src = 'https://accounts.google.com/gsi/client';
    gsi.async = true;
    gsi.defer = true;
    document.head.appendChild(gsi);

    gsi.onload = function() {
        if (!(window.google && google.accounts && google.accounts.id)) return;

        // Wrap prompt in a DOM-ready check + try/catch to silence an
        // occasional "a.parentNode is null" error from the GSI client
        // library that fires when it tries to mount before the body is
        // fully laid out. The error is harmless (prompt retries itself)
        // but it spams the browser console.
        function bccStartOneTap() {
            try {
                google.accounts.id.initialize({
                    client_id: '575746008328-k58qv7qvto46fa222qk79jggu6ggtgl8.apps.googleusercontent.com',
                    callback: window.bccOneTapCallback,
                    cancel_on_tap_outside: false,
                    context: 'signup',
                    itp_support: true
                });
                google.accounts.id.prompt();
            } catch (e) {
                // Silently swallow — prompt will auto-retry on next navigation
            }
        }
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            // Short delay so GSI can finish its internal setup before we call prompt
            setTimeout(bccStartOneTap, 300);
        } else {
            document.addEventListener('DOMContentLoaded', function() {
                setTimeout(bccStartOneTap, 300);
            });
        }
    };
})();

window.bccOneTapCallback = function(response) {
    if (!response || !response.credential) return;

    // Set cookie IMMEDIATELY — prevents prompt re-appearing even if the
    // AJAX call below fails or is slow. Plain cookie (no Secure flag so it
    // still works on http test domains and inside iframes).
    document.cookie = 'bcc_onetap_done=1;path=/;max-age=2592000;SameSite=Lax';

    // Cancel further prompts in this session
    if (window.google && google.accounts && google.accounts.id) {
        google.accounts.id.cancel();
    }

    var xhr = new XMLHttpRequest();
    xhr.open('POST', 'https://brainrotcharacters.net/wp-admin/admin-ajax.php', true);
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function() {
        try {
            var data = JSON.parse(xhr.responseText);
            if (data.success && data.data) {
                if (data.data.email) {
                    document.cookie = 'bcc_google_email=' + encodeURIComponent(data.data.email) + ';path=/;max-age=2592000;SameSite=Lax';
                }
                if (data.data.name) {
                    document.cookie = 'bcc_google_name=' + encodeURIComponent(data.data.name) + ';path=/;max-age=2592000;SameSite=Lax';
                }
            }
        } catch(e) {}
    };
    xhr.send('action=bcc_onetap&_ajax_nonce=f0fc3b8095&token=' + encodeURIComponent(response.credential));
};
</script><script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9172619528403822" crossorigin="anonymous"></script><style class="wpcode-css-snippet">.single-character .ultp-builder-container {padding-top: 20px;padding-bottom: 20px;}


.site-header,
header.site-header {
  min-height: 80px; /* pielāgo savai galvenei */
}

/* Submenu nedrīkst push'ot saturu */
.main-navigation ul ul {
  position: absolute;
}

.entry-content a > img[src*="-pdf.jpg"] {
  aspect-ratio: 3 / 4;
  width: 100%;
  height: auto;
}</style><style class="wpcode-css-snippet">/**
 * Italian Brainrot Character Styles
 *
 * Add as CSS Snippet in Code Snippets plugin
 * OR paste into: Appearance > Customize > Additional CSS
 *
 * CHANGES:
 * - Gallery updated to auto-fit up to 6 images (3 per row on desktop, 2 on mobile)
 * - Added .br-gal-download button (Download) under each gallery image
 * - br-gal-card uses overflow:hidden so all child corners clip cleanly
 */

.br *{margin:0;padding:0;box-sizing:border-box}
.br ul,.br ol{list-style:none}
.br img{box-shadow:none !important;border-radius:0 !important;}
.br .ns-pinterest-image-button{z-index:5;}
.br h3{font-size:inherit;font-weight:inherit;margin:0;padding:0;line-height:inherit;color:inherit;}
.br blockquote{margin:0;padding:0;border:none;}
.br figure{margin:0;padding:0;}

.br {
    background: #fff;
    color: #1F2937;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 0 40px;
    line-height: 1.6;
}

/* HERO */
.br-hero {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 0;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 32px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
}

.br-hero-img {
    position: relative;
    overflow: hidden;
    background: #F3F4F6;
    min-height: 360px;
}

.br-hero-img .ns-pinterest-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
}

.br-hero-img img,
.br-hero-img .br-hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    max-width: none;
    border-radius: 0 !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
}

.br-num {
    position: absolute;
    bottom: 32px;
    right: 12px;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    color: #111827;
    font-weight: 800;
    font-size: 14px;
    padding: 5px 12px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    z-index: 2;
}

.br-hero-cap {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    color: #fff;
    font-size: 11px;
    padding: 6px 14px;
    text-align: center;
    z-index: 1;
}

.br-info {
    padding: 40px 44px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #FAFAFA;
}

.br-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.br-bg {
    font-size: 11px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 8px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

.br-clan { background: #D1FAE5; color: #065F46; }
.br-status { background: #EDE9FE; color: #5B21B6; }
.br-role { background: #FEF3C7; color: #92400E; }

.br-title {
    font-size: 36px !important;
    font-weight: 800 !important;
    line-height: 1.1 !important;
    margin: 0 0 8px !important;
    color: #111827 !important;
    letter-spacing: -0.5px;
    padding: 0 !important;
}

.br-tag {
    font-size: 17px;
    font-style: italic;
    color: #6B7280;
    margin-bottom: 6px;
}

.br-aka {
    font-size: 14px;
    color: #9CA3AF;
    margin-bottom: 24px;
}

.br-meta {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid #E5E7EB;
}

.br-ml {
    font-size: 10px;
    color: #9CA3AF;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 3px;
}

.br-mv {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
}

/* CATCHPHRASE */
.br-cq {
    background: linear-gradient(135deg, #8B5CF6, #EC4899);
    padding: 15px 36px;
    border-radius: 16px;
    margin-top: 15px;
    margin-bottom: 15px;
    position: relative;
    overflow: hidden;
    text-align: center;
}

.br-cq::before {
    content: '\201C';
    position: absolute;
    top: -10px;
    left: 20px;
    font-size: 100px;
    font-weight: 900;
    color: rgba(255,255,255,0.15);
    line-height: 1;
    font-family: Georgia, serif;
}

.br-cq p {
    font-size: 20px;
    font-weight: 600;
    font-style: italic;
    color: #fff;
    position: relative;
    z-index: 1;
    margin: 0 !important;
    padding: 0 !important;
}

/* SECTION TITLES */
.br-st {
    font-size: 20px !important;
    font-weight: 700 !important;
    color: #111827 !important;
    margin: 10px 0 18px !important;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 !important;
}

.br-st::after {
    content: '';
    flex: 1;
    height: 2px;
    background: #F3F4F6;
    border-radius: 1px;
}

.br-ti {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}

/* STATS */
.br-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 36px;
    margin-bottom: 40px;
    background: #FAFAFA;
    border-radius: 16px;
    padding: 28px 32px;
}

.br-sh {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.br-sn {
    font-size: 14px;
    color: #6B7280;
    font-weight: 500;
}

.br-sv {
    font-weight: 700;
    color: #111827;
    font-size: 14px;
}

.br-bar {
    height: 10px;
    background: #F3F4F6;
    border-radius: 99px;
    overflow: hidden;
}

.br-fill {
    height: 100%;
    border-radius: 99px;
    transition: width 1s ease;
}

/* CHARACTER INFO */
.br-ig {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    background: #FAFAFA;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 40px;
}

.br-ic {
    padding: 20px 24px;
    border-right: 1px solid #F3F4F6;
    border-bottom: 1px solid #F3F4F6;
}

.br-ic:nth-child(3n) { border-right: none; }
.br-ic:nth-child(n+4) { border-bottom: none; }

.br-il {
    font-size: 10px;
    color: #9CA3AF;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 4px;
}

.br-iv {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
}

/* TEXT */
.br-tx {
    font-size: 16px;
    color: #4B5563;
    line-height: 1.85;
    margin-bottom: 40px;
}

.br-tx p { margin-bottom: 16px; }
.br-tx p:last-child { margin-bottom: 0; }

/* GALLERY */
.br-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 40px;
}

.br-gal-card {
    border-radius: 12px;
    background: #FAFAFA;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.br-gal-img-wrap {
    line-height: 0;
    font-size: 0;
}

.br-gal-img-wrap .ns-pinterest-image {
    display: block !important;
    line-height: 0 !important;
    font-size: 0 !important;
}

.br-gallery-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
}

.br-gal-cap {
    font-size: 12px;
    color: #6B7280;
    text-align: center;
    padding: 8px 10px;
    line-height: 1.4;
}

.br-gal-download {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    margin-top: auto;
    background: #3B82F6;
    color: #fff !important;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none !important;
    letter-spacing: 0.3px;
    transition: background 0.2s ease;
    border: none;
    cursor: pointer;
}

.br-gal-download:hover,
.br-gal-download:focus {
    background: #2563EB;
    color: #fff !important;
    text-decoration: none !important;
}

.br-gal-download:active {
    background: #1D4ED8;
}

/* ABILITIES */
.br-ab {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 40px;
}

.br-ac {
    background: #FAFAFA;
    border-radius: 14px;
    padding: 24px 26px;
    border: 1px solid transparent;
    transition: transform 0.2s, box-shadow 0.2s;
}

.br-ac:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border-color: #E5E7EB;
}

.br-an {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 8px !important;
    padding: 0 !important;
    line-height: 1.3;
}

.br-ad {
    font-size: 14px;
    color: #6B7280;
    line-height: 1.65;
}

.br-sp {
    background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
    border: 1px solid #FCD34D;
}

.br-sp:hover { border-color: #F59E0B; }
.br-sp .br-an { color: #92400E !important; }
.br-sp .br-ad { color: #78350F; }

/* RELATIONSHIPS */
.br-rl {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 40px;
}

.br-rc {
    background: #FAFAFA;
    border-radius: 12px;
    padding: 18px 20px;
}

.br-rla {
    font-size: 10px;
    color: #9CA3AF;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin: 0 0 8px !important;
    padding: 0 !important;
    font-weight: 600;
    line-height: 1;
}

.br-rv {
    font-size: 14px;
    color: #374151;
    line-height: 1.65;
}

/* BATTLE RECORD */
.br-battle {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 0;
    background: #FAFAFA;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 40px;
}

.br-battle-left {
    background: linear-gradient(135deg, #FFFBEB, #FEF3C7);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
}

.br-battle-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
    border: 3px solid #fff;
    margin-bottom: 4px;
}

.br-battle-left .ns-pinterest-image {
    display: inline-block;
    line-height: 0;
}

.br-battle-left .ns-pinterest-image-button {
    display: none !important;
}

.br-battle-name {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
}

.br-battle-clan {
    font-size: 11px;
    font-weight: 600;
    color: #065F46;
    background: #D1FAE5;
    padding: 3px 10px;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.br-battle-role {
    font-size: 12px;
    color: #92400E;
    font-weight: 500;
}

.br-battle-right {
    padding: 28px 32px;
    font-size: 15px;
    color: #4B5563;
    line-height: 1.8;
}

.br-battle-right p {
    margin-bottom: 6px;
    padding: 6px 0;
    border-bottom: 1px solid #F3F4F6;
}

.br-battle-right p:last-child {
    border-bottom: none;
}

/* EXTRAS */
.br-ex {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 40px;
}

.br-ec {
    background: #FAFAFA;
    border-radius: 14px;
    padding: 22px 26px;
}

.br-el {
    font-size: 10px;
    color: #9CA3AF;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin: 0 0 8px !important;
    padding: 0 !important;
    font-weight: 600;
    line-height: 1;
}

.br-ev {
    font-size: 15px;
    color: #4B5563;
    line-height: 1.75;
}

/* INSERTION SLOTS */
.br-slot:empty { display: none; }
.br-slot { margin: 20px 0; text-align: center; }

/* RESPONSIVE */
@media (max-width: 768px) {
    .br { padding: 0 0 40px; }
    .br-hero { grid-template-columns: 1fr; }
    .br-hero-img { min-height: 300px; }
    .br-info { padding: 24px; }
    .br-title { font-size: 28px !important; }
    .br-stats { grid-template-columns: 1fr; padding: 20px; }
    .br-ig { grid-template-columns: 1fr 1fr; }
    .br-ic:nth-child(2n) { border-right: none; }
    .br-ic { border-bottom: 1px solid #F3F4F6; }
    .br-ic:last-child { border-bottom: none; }
    .br-ab { grid-template-columns: 1fr; }
    .br-gallery { grid-template-columns: 1fr; gap: 10px; }
    .br-gal-cap { font-size: 11px; padding: 6px 6px; }
    .br-gal-download { font-size: 12px; padding: 9px 10px; }
    .br-rl { grid-template-columns: 1fr 1fr; gap: 10px; }
    .br-meta { grid-template-columns: 1fr 1fr; }
    .br-battle { grid-template-columns: 1fr; }
    .br-battle-left { flex-direction: row; padding: 16px 20px; gap: 12px; }
    .br-battle-avatar { width: 50px; height: 50px; }
}</style><link rel="icon" href="https://brainrotcharacters.net/wp-content/uploads/2026/04/favicon-transparent-150x150.webp" sizes="32x32" />
<link rel="icon" href="https://brainrotcharacters.net/wp-content/uploads/2026/04/favicon-transparent-300x300.webp" sizes="192x192" />
<link rel="apple-touch-icon" href="https://brainrotcharacters.net/wp-content/uploads/2026/04/favicon-transparent-300x300.webp" />
<meta name="msapplication-TileImage" content="https://brainrotcharacters.net/wp-content/uploads/2026/04/favicon-transparent-300x300.webp" />
<style id="wp-custom-css">
html, body {
    overflow-x: hidden;
    width: 100%;
}

</style>
